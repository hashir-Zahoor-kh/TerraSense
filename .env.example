# Required — set these in Render dashboard / Vercel env vars, never commit real values
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
API_KEY=<generate: openssl rand -hex 32>
ANTHROPIC_API_KEY=sk-ant-...
AWS_REGION=us-east-1

# Optional — only needed for real terraform apply (plan-only demo works without these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional — defaults shown
TERRAFORM_WORKING_DIR=/tmp/terrasense_workspaces
MAX_CORRECTION_RETRIES=3
ENVIRONMENT=production
